@*
    =======================================================================
    SAMPLE: Calendar view — daily / weekly / monthly
    =======================================================================
    Reference sample (not business data). Mirrors the layout of
    ckd_tracing/Views/Pages/ProductionSequence/Index.cshtml but adds a
    DAILY view and drops the export/upload modals to keep the sample focused.

    To render it, the ExamplesController.CalendarSample action builds a
    CalendarSampleViewModel filled with deterministic mock data. Navigate to
    /Examples/CalendarSample?view=monthly|weekly|daily.

    Adapt for a real page by:
      - Replacing CalendarSampleViewModel with your own VM.
      - Swapping GenerateItems() in the controller for a real query
        (e.g. staff_absence table joined with staff master).
      - Wiring handleDayClick() to open your own editor / detail panel.
    =======================================================================
*@
@using mvc_boilerplate.Models.ViewModels
@model CalendarSampleViewModel
@{
    ViewData["Title"] = "Staff Absence Calendar";
    ViewData["Module"] = "Examples";

    var today = DateOnly.FromDateTime(DateTime.Today);

    // Prev/Next month (monthly mode)
    var prevMonth = Model.Month == 1 ? 12 : Model.Month - 1;
    var prevYear = Model.Month == 1 ? Model.Year - 1 : Model.Year;
    var nextMonth = Model.Month == 12 ? 1 : Model.Month + 1;
    var nextYear = Model.Month == 12 ? Model.Year + 1 : Model.Year;

    // Safe values for the view-toggle links: when we are NOT already in
    // daily/weekly mode, SelectedDate/WeekStart are default(DateOnly)=0001-01-01.
    // Passing that bogus date would later make AddDays(-1/-7) underflow DateOnly,
    // so fall back to today when switching in from another mode.
    var dailyToggleDate  = Model.ViewMode == "daily"  ? Model.SelectedDate : today;
    var weeklyToggleStart = Model.ViewMode == "weekly" ? Model.WeekStart     : today;

    // Prev/Next week (weekly mode) — only compute in weekly mode to avoid DateOnly overflow
    var prevWeekStart = Model.ViewMode == "weekly" ? Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd") : "";
    var nextWeekStart = Model.ViewMode == "weekly" ? Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd") : "";

    // Prev/Next day (daily mode)
    var prevDate = Model.ViewMode == "daily" ? Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd") : "";
    var nextDate = Model.ViewMode == "daily" ? Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd") : "";

    // Calendar padding for monthly view (Monday = 0)
    var firstOfMonth = new DateOnly(Model.Year, Model.Month, 1);
    int startPad = ((int)firstOfMonth.DayOfWeek - 1 + 7) % 7;

    // Tailwind classes for the active vs inactive view-toggle buttons
    var activeBtn = "bg-brand text-white border-brand";
    var idleBtn = "bg-white border-gray-300 text-gray-600 hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700";

    // Absence type → badge color (sample palette). Used by the daily view.
    var typeColors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Annual Leave"] = "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300",
        ["Sick"]         = "bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300",
        ["Emergency"]    = "bg-orange-100 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300",
        ["Unpaid"]       = "bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-200",
        ["Maternity"]    = "bg-pink-100 text-pink-700 dark:bg-pink-900/40 dark:text-pink-300"
    };
}

<div class="p-4 md:p-6 space-y-4">
    <!-- Page Header -->
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between mb-2">
        <div>
            <h1 class="text-2xl font-bold text-gray-700 dark:text-white">Staff Absence Calendar</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">Daily / Weekly / Monthly view of absent staff</p>
        </div>

        <!-- View toggle: Daily / Weekly / Monthly -->
        <div class="flex items-center gap-2">
            <a asp-action="CalendarSample" asp-route-view="daily" asp-route-date="@dailyToggleDate.ToString("yyyy-MM-dd")"
               class="px-3 py-2 text-sm rounded-lg border inline-flex items-center gap-1 @(Model.ViewMode == "daily" ? activeBtn : idleBtn)">
                <i class="iconify" data-icon="material-symbols-light:calendar-today"></i> Daily
            </a>
            <a asp-action="CalendarSample" asp-route-view="weekly" asp-route-weekStart="@weeklyToggleStart.ToString("yyyy-MM-dd")"
               asp-route-month="@Model.Month" asp-route-year="@Model.Year"
               class="px-3 py-2 text-sm rounded-lg border inline-flex items-center gap-1 @(Model.ViewMode == "weekly" ? activeBtn : idleBtn)">
                <i class="iconify" data-icon="material-symbols-light:view-week"></i> Weekly
            </a>
            <a asp-action="CalendarSample" asp-route-view="monthly" asp-route-month="@Model.Month" asp-route-year="@Model.Year"
               class="px-3 py-2 text-sm rounded-lg border inline-flex items-center gap-1 @(Model.ViewMode == "monthly" ? activeBtn : idleBtn)">
                <i class="iconify" data-icon="material-symbols-light:calendar-month"></i> Monthly
            </a>
        </div>

        <!-- Prev / Next navigation -->
        <div class="flex items-center gap-2">
            @if (Model.ViewMode == "daily")
            {
                <a asp-action="CalendarSample" asp-route-view="daily" asp-route-date="@prevDate"
                   class="p-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700">
                    <i class="iconify" data-icon="material-symbols-light:chevron-left"></i>
                </a>
                <span class="text-sm font-semibold text-gray-700 dark:text-white min-w-[220px] text-center">
                    @Model.NavigationLabel
                </span>
                <a asp-action="CalendarSample" asp-route-view="daily" asp-route-date="@nextDate"
                   class="p-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700">
                    <i class="iconify" data-icon="material-symbols-light:chevron-right"></i>
                </a>
            }
            else if (Model.ViewMode == "weekly")
            {
                <a asp-action="CalendarSample" asp-route-view="weekly" asp-route-weekStart="@prevWeekStart"
                   asp-route-month="@Model.Month" asp-route-year="@Model.Year"
                   class="p-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700">
                    <i class="iconify" data-icon="material-symbols-light:chevron-left"></i>
                </a>
                <span class="text-sm font-semibold text-gray-700 dark:text-white min-w-[200px] text-center">
                    @Model.NavigationLabel
                </span>
                <a asp-action="CalendarSample" asp-route-view="weekly" asp-route-weekStart="@nextWeekStart"
                   asp-route-month="@Model.Month" asp-route-year="@Model.Year"
                   class="p-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700">
                    <i class="iconify" data-icon="material-symbols-light:chevron-right"></i>
                </a>
            }
            else
            {
                <a asp-action="CalendarSample" asp-route-month="@prevMonth" asp-route-year="@prevYear" asp-route-view="monthly"
                   class="p-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700">
                    <i class="iconify" data-icon="material-symbols-light:chevron-left"></i>
                </a>
                <span class="text-sm font-semibold text-gray-700 dark:text-white min-w-[160px] text-center">
                    @Model.NavigationLabel
                </span>
                <a asp-action="CalendarSample" asp-route-month="@nextMonth" asp-route-year="@nextYear" asp-route-view="monthly"
                   class="p-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700">
                    <i class="iconify" data-icon="material-symbols-light:chevron-right"></i>
                </a>
            }
        </div>
    </div>

    @* ======================== MONTHLY VIEW ======================== *@
    @if (Model.ViewMode == "monthly")
    {
        <div class="border rounded-lg bg-white dark:bg-gray-800 shadow-default dark:border-gray-700 overflow-hidden">
            <!-- Day headers -->
            <div class="grid grid-cols-7 border-b dark:border-gray-700">
                @foreach (var day in new[] { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" })
                {
                    <div class="px-2 py-2 text-center text-xs font-semibold text-gray-500 dark:text-gray-400 @(day == "SAT" || day == "SUN" ? "bg-gray-50 dark:bg-gray-900" : "")">
                        @day
                    </div>
                }
            </div>
            <!-- Calendar cells -->
            <div class="grid grid-cols-7">
                @* Padding cells for days before the 1st *@
                @for (int i = 0; i < startPad; i++)
                {
                    <div class="min-h-[90px] border-b border-r dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/20"></div>
                }
                @foreach (var day in Model.MonthDays)
                {
                    var isToday = day.Date == today;
                    var isWeekend = day.Date.DayOfWeek == DayOfWeek.Saturday || day.Date.DayOfWeek == DayOfWeek.Sunday;
                    var dateStr = day.Date.ToString("yyyy-MM-dd");
                    var hasRows = day.RowCount > 0;
                    <div class="min-h-[90px] border-b border-r dark:border-gray-700 p-1.5 cursor-pointer hover:bg-blue-50/50 dark:hover:bg-blue-900/20 transition-colors @(isWeekend ? "bg-gray-50/50 dark:bg-gray-900/20" : "")"
                         data-date="@dateStr"
                         data-has-rows="@hasRows.ToString().ToLower()"
                         onclick="handleDayClick('@dateStr')">
                        <div class="flex items-start justify-between">
                            <span class="text-xs font-medium @(isToday ? "bg-brand text-white rounded-full w-6 h-6 flex items-center justify-center" : "text-gray-600 dark:text-gray-400")">
                                @day.Date.Day
                            </span>
                            @if (day.RowCount > 0)
                            {
                                <span class="px-1.5 py-0.5 text-[10px] rounded font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">
                                    @day.RowCount ABSENT
                                </span>
                            }
                        </div>
                        @if (day.RowCount > 0)
                        {
                            <div class="mt-1 text-[10px] text-gray-500 dark:text-gray-400 truncate">
                                @day.Rows.First().StaffName
                                @(day.RowCount > 1 ? $" +{(day.RowCount - 1)}" : "")
                            </div>
                        }
                    </div>
                }
                @* Padding cells at end *@
                @{
                    var totalCells = startPad + Model.MonthDays.Count;
                    var remaining = (7 - totalCells % 7) % 7;
                }
                @for (int i = 0; i < remaining; i++)
                {
                    <div class="min-h-[90px] border-b border-r dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/20"></div>
                }
            </div>
        </div>
    }

    @* ======================== WEEKLY VIEW ======================== *@
    @if (Model.ViewMode == "weekly")
    {
        <div class="border rounded-lg bg-white dark:bg-gray-800 shadow-default dark:border-gray-700 overflow-hidden">
            <div class="grid grid-cols-7 divide-x dark:divide-gray-700">
                @foreach (var day in Model.WeekDays)
                {
                    var isToday = day.Date == today;
                    var dateStr = day.Date.ToString("yyyy-MM-dd");
                    var dayName = day.Date.DayOfWeek.ToString().Substring(0, 3).ToUpper();
                    var hasWeekRows = day.RowCount > 0;
                    <div class="min-h-[300px] cursor-pointer hover:bg-blue-50/50 dark:hover:bg-blue-900/20 transition-colors"
                         data-date="@dateStr"
                         data-has-rows="@hasWeekRows.ToString().ToLower()"
                         onclick="handleDayClick('@dateStr')">
                        <!-- Day header -->
                        <div class="px-2 py-2 border-b dark:border-gray-700 text-center @(isToday ? "bg-brand/10" : "")">
                            <div class="text-[10px] font-semibold text-gray-500 dark:text-gray-400">@dayName</div>
                            <div class="text-sm font-bold @(isToday ? "text-brand" : "text-gray-700 dark:text-white")">@day.Date.Day</div>
                        </div>
                        <!-- Absence chips -->
                        <div class="p-2 space-y-1">
                            @if (day.Rows.Any())
                            {
                                @foreach (var row in day.Rows)
                                {
                                    <div class="px-2 py-1 text-[11px] rounded bg-amber-50 text-amber-800 dark:bg-amber-900/30 dark:text-amber-200 truncate"
                                         title="@row.StaffName — @row.AbsenceType (@row.Duration)">
                                        @row.StaffName
                                    </div>
                                }
                                <div class="mt-1 text-[10px] font-semibold text-gray-500 dark:text-gray-400 text-center">
                                    @day.RowCount ABSENT
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ======================== DAILY VIEW ======================== *@
    @if (Model.ViewMode == "daily")
    {
        var isToday = Model.SelectedDate == today;
        var dateStr = Model.SelectedDate.ToString("yyyy-MM-dd");

        <div class="border rounded-lg bg-white dark:bg-gray-800 shadow-default dark:border-gray-700 overflow-hidden">
            <!-- Day header -->
            <div class="flex items-center justify-between px-4 py-3 border-b dark:border-gray-700 @(isToday ? "bg-brand/10" : "bg-gray-50 dark:bg-gray-900")">
                <div class="flex items-center gap-3">
                    <i class="iconify text-xl text-brand" data-icon="material-symbols-light:calendar-today"></i>
                    <div>
                        <div class="text-sm font-bold text-gray-700 dark:text-white">@Model.SelectedDate.ToString("dddd")</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@Model.SelectedDate.ToString("dd MMMM yyyy")</div>
                    </div>
                </div>
                <span class="px-2 py-1 text-[11px] rounded font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">
                    @Model.DayItems.Count ABSENT
                </span>
            </div>

            <!-- Timeline list -->
            <div class="p-4" data-date="@dateStr" data-has-rows="@(Model.DayItems.Any()).ToString().ToLower()">
                @if (Model.DayItems.Any())
                {
                    var seq = 1;
                    <ul class="space-y-3">
                        @foreach (var item in Model.DayItems)
                        {
                            var badge = typeColors.TryGetValue(item.AbsenceType, out var c) ? c : "bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300";
                            <li class="flex gap-3 group">
                                <!-- Index column -->
                                <div class="w-10 flex-shrink-0 text-right">
                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-[11px] font-semibold text-gray-500 dark:bg-gray-700 dark:text-gray-300">@seq</span>
                                </div>
                                <!-- Timeline dot + line -->
                                <div class="relative flex flex-col items-center">
                                    <span class="w-3 h-3 rounded-full bg-amber-400 mt-1.5 ring-4 ring-amber-400/10"></span>
                                    <span class="w-px flex-1 bg-gray-200 dark:bg-gray-700 mt-1"></span>
                                </div>
                                <!-- Absence card -->
                                <div class="flex-1 pb-3">
                                    <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-3 group-hover:border-brand transition-colors">
                                        <div class="flex items-center justify-between gap-2 flex-wrap">
                                            <div class="flex items-center gap-2">
                                                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-brand text-white text-xs font-semibold">
                                                    @(item.StaffName.Length > 0 ? item.StaffName[..1] : "?")
                                                </span>
                                                <span class="text-sm font-semibold text-gray-700 dark:text-white">@item.StaffName</span>
                                            </div>
                                            <span class="px-2 py-0.5 text-[10px] rounded font-medium @badge">
                                                @item.AbsenceType
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-4 mt-2 text-xs text-gray-500 dark:text-gray-400">
                                            <span class="inline-flex items-center gap-1">
                                                <i class="iconify w-3.5 h-3.5" data-icon="material-symbols-light:schedule"></i>
                                                @item.Duration
                                            </span>
                                            @if (!string.IsNullOrEmpty(item.Remarks))
                                            {
                                                <span class="inline-flex items-center gap-1">
                                                    <i class="iconify w-3.5 h-3.5" data-icon="material-symbols-light:notes"></i>
                                                    @item.Remarks
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </li>
                            seq++;
                        }
                    </ul>
                }
                else
                {
                    <div class="py-12 text-center">
                        <i class="iconify text-4xl mb-2 text-gray-300 dark:text-gray-600" data-icon="material-symbols-light:check-circle"></i>
                        <p class="text-sm text-gray-500 dark:text-gray-400">No staff absent on this day.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    // Click handler for calendar day cells (monthly + weekly).
    // In this sample it just surfaces a toast via the shared Notification
    // globals (rendered once in _Layout). Wire this to your own editor /
    // detail panel when adapting the sample.
    function handleDayClick(date) {
        const cell = document.querySelector(`[data-date="${date}"]`);
        const hasRows = cell?.dataset.hasRows === 'true';

        if (hasRows) {
            showInfo(`Showing absences for ${date}. (Wire loadViewPanel('${date}') here.)`);
        } else {
            showInfo(`No absences on ${date}. (Wire openAddAbsenceModal('${date}') here.)`);
        }
    }
</script>
}