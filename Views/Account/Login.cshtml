@model mvc_boilerplate.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>@ViewData["Title"] - MVC Boilerplate</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body.login-page {
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: #ffffff;
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 20px 20px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            position: relative;
        }

        /* Red top line */
        body.login-page::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: #e11d48;
            z-index: 100;
        }

        /* Card */
        .login-card {
            background: #fff;
            border-radius: 1.25rem;
            box-shadow: 0 4px 32px rgba(99, 102, 241, 0.08), 0 1.5px 6px rgba(0,0,0,0.04);
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 460px;
            border: 1px solid rgba(99, 102, 241, 0.08);
        }
        .login-card .card-logo {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .login-card .card-logo img {
            max-width: 180px;
            height: auto;
            display: block;
            margin: 0 auto;
        }
        .login-card .card-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1e1e2f;
            margin-bottom: 0.25rem;
        }
        .login-card .card-desc {
            font-size: 0.85rem;
            color: #6b7280;
            margin-bottom: 1.5rem;
        }

        /* Register links */
        .login-register-links {
            text-align: center;
            margin-top: 1rem;
        }
        .login-register-links p {
            font-size: 0.8rem;
            color: #6b7280;
            margin-bottom: 0.375rem;
        }
        .login-register-links a {
            color: #6366f1;
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s;
        }
        .login-register-links a:hover {
            color: #4338ca;
            text-decoration: underline;
        }

        /* Footer */
        .login-footer {
            text-align: center;
            margin-top: 2rem;
            font-size: 0.7rem;
            color: #9ca3af;
            letter-spacing: 0.04em;
        }
        .login-footer p { margin-bottom: 0.5rem; }
        .login-footer-links {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-size: 0.75rem;
        }
        .login-footer-links a {
            color: #6366f1;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }
        .login-footer-links a:hover {
            color: #4338ca;
            text-decoration: underline;
        }
        .login-footer-dot { color: #cbd5e1; }

        /* Remember me & Forgot password row */
        .login-remember-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }
        .login-remember-label {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.8rem;
            font-weight: 500;
            color: #374151;
            cursor: pointer;
            user-select: none;
        }
        .login-remember-label input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #6366f1;
            border-radius: 4px;
            cursor: pointer;
        }
        .login-forgot-link {
            font-size: 0.8rem;
            font-weight: 500;
            color: #6366f1;
            text-decoration: none;
            transition: color 0.2s;
        }
        .login-forgot-link:hover {
            color: #4338ca;
            text-decoration: underline;
        }

        /* ---- Dark Mode ---- */
        body.login-page.dark,
        html body.login-page.dark {
            background-color: #0f172a !important;
            background-image: radial-gradient(#475569 1px, transparent 1px) !important;
            background-size: 20px 20px !important;
            color: #e2e8f0 !important;
        }

        .dark .login-card {
            background: #1e293b;
            border-color: rgba(99, 102, 241, 0.15);
            box-shadow: 0 4px 32px rgba(0,0,0,0.3);
        }
        .dark .login-card .card-title { color: #e2e8f0; }
        .dark .login-card .card-desc { color: #94a3b8; }
        .dark .login-register-links p { color: #94a3b8; }
        .dark .login-register-links a { color: #a5b4fc; }
        .dark .login-register-links a:hover { color: #c7d2fe; }
        .dark .login-footer { color: #64748b; }
        .dark .login-remember-label { color: #cbd5e1; }
        .dark .login-forgot-link { color: #a5b4fc; }
        .dark .login-forgot-link:hover { color: #c7d2fe; }
        .dark .login-footer-links a { color: #a5b4fc; }
        .dark .login-footer-links a:hover { color: #c7d2fe; }
        .dark .login-footer-dot { color: #475569; }

        /* Dark mode toggler */
        .dark-mode-toggler {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 50;
            width: 3.5rem;
            height: 3.5rem;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%);
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
            transition: all 0.2s ease;
        }
        .dark-mode-toggler:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
        }

        /* ---- Responsive ---- */
        @@media (max-width: 480px) {
            body.login-page { padding: 0.75rem; }
            .login-card { padding: 1.75rem 1.25rem; border-radius: 1rem; }
            .login-card .card-title { font-size: 1.25rem; }
            .azure-ad-btn { display: none !important; }
            .auth-divider-text { display: none !important; }
        }
        @@media (min-width: 481px) and (max-width: 768px) {
            .login-card { padding: 2rem 1.5rem; }
        }
        @@media (min-height: 900px) {
            .login-footer { margin-top: 3rem; }
        }

        .validation-summary-errors ul {
            list-style: none;
            padding: 0;
        }
        .validation-summary-errors ul li {
            font-size: 0.8rem;
            color: #ef4444;
            margin-bottom: 0.25rem;
        }

        /* ---- Forgot Password Modal ---- */
        .forgot-modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 200;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(2px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }
        .forgot-modal-overlay.show {
            opacity: 1;
            visibility: visible;
        }
        .forgot-modal-card {
            background: #fff;
            border-radius: 1rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
            width: 100%;
            max-width: 540px;
            padding: 1.75rem 1.75rem 1.5rem;
            position: relative;
            transform: scale(0.95);
            transition: transform 0.2s ease;
        }
        .forgot-modal-overlay.show .forgot-modal-card {
            transform: scale(1);
        }
        .forgot-modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            width: 2rem;
            height: 2rem;
            border-radius: 9999px;
            background: #f1f5f9;
            color: #64748b;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.2s ease, color 0.2s ease;
        }
        .forgot-modal-close:hover {
            background: #e2e8f0;
            color: #1f2937;
        }
        .forgot-modal-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.75rem;
            padding-right: 2.5rem;
        }
        .forgot-modal-desc {
            font-size: 0.9rem;
            line-height: 1.55;
            color: #475569;
            margin-bottom: 1.5rem;
            text-align: left;
        }
        .forgot-modal-actions {
            display: flex;
            justify-content: flex-end;
        }
        .forgot-modal-btn {
            background: #6366f1;
            color: #fff;
            border: none;
            border-radius: 0.5rem;
            padding: 0.65rem 1.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
        }
        .forgot-modal-btn:hover {
            background: #4338ca;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }
        .forgot-modal-btn:active {
            transform: translateY(1px);
        }

        /* Dark mode support */
        body.login-page.dark .forgot-modal-card {
            background: #1e293b;
            border: 1px solid rgba(99, 102, 241, 0.15);
        }
        body.login-page.dark .forgot-modal-close {
            background: #334155;
            color: #94a3b8;
        }
        body.login-page.dark .forgot-modal-close:hover {
            background: #475569;
            color: #e2e8f0;
        }
        body.login-page.dark .forgot-modal-title { color: #e2e8f0; }
        body.login-page.dark .forgot-modal-desc { color: #94a3b8; }

        /* ---- Privacy Policy Modal ---- */
        .privacy-modal-body {
            font-size: 0.875rem;
            line-height: 1.65;
            color: #374151;
        }
        .privacy-modal-body h3 {
            font-size: 0.95rem;
            font-weight: 700;
            color: #1e1e2f;
            margin-bottom: 0.75rem;
        }
        .privacy-modal-body p {
            margin-bottom: 0.75rem;
        }
        .privacy-modal-body strong {
            font-weight: 600;
            color: #1e1e2f;
        }
        .privacy-modal-scroll {
            max-height: 60vh;
            overflow-y: auto;
            padding-right: 0.25rem;
        }
        body.login-page.dark .privacy-modal-body { color: #94a3b8; }
        body.login-page.dark .privacy-modal-body h3 { color: #e2e8f0; }
        body.login-page.dark .privacy-modal-body strong { color: #e2e8f0; }

        /* QR Code Login Button */
        .qr-login-btn {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 0.625rem;
            background: #fff;
            color: #6366f1;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 0.75rem;
        }
        .qr-login-btn:hover {
            border-color: #6366f1;
            background: rgba(99, 102, 241, 0.05);
        }
        body.login-page.dark .qr-login-btn {
            background: #1e293b;
            border-color: #475569;
            color: #a5b4fc;
        }
        body.login-page.dark .qr-login-btn:hover {
            border-color: #818cf8;
            background: rgba(99, 102, 241, 0.1);
        }

        /* QR Code Modal */
        .qr-modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 100;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .qr-modal.active { display: flex; }
        .qr-modal-content {
            background: #fff;
            border-radius: 1.25rem;
            padding: 2rem;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 8px 48px rgba(0, 0, 0, 0.2);
            position: relative;
        }
        body.login-page.dark .qr-modal-content {
            background: #1e293b;
        }
        .qr-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .qr-modal-title {
            font-size: 1.375rem;
            font-weight: 700;
            color: #1e1e2f;
        }
        body.login-page.dark .qr-modal-title { color: #e2e8f0; }
        .qr-modal-close {
            background: none;
            border: none;
            cursor: pointer;
            color: #9ca3af;
            padding: 0.25rem;
            display: flex;
            align-items: center;
            transition: color 0.2s;
        }
        .qr-modal-close:hover { color: #374151; }
        body.login-page.dark .qr-modal-close { color: #64748b; }
        body.login-page.dark .qr-modal-close:hover { color: #cbd5e1; }
        .qr-input-group {
            margin-bottom: 1rem;
        }
        .qr-input-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
        }
        body.login-page.dark .qr-input-label { color: #cbd5e1; }
        .qr-input {
            width: 100%;
            padding: 0.875rem 1rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 0.625rem;
            font-size: 1rem;
            color: #1e1e2f;
            background: #fff;
            transition: all 0.2s ease;
            outline: none;
            text-align: center;
            letter-spacing: 0.05em;
        }
        .qr-input::placeholder { color: #9ca3af; }
        .qr-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }
        body.login-page.dark .qr-input {
            background: #0f172a;
            border-color: #475569;
            color: #e2e8f0;
        }
        body.login-page.dark .qr-input::placeholder { color: #64748b; }
        body.login-page.dark .qr-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }
        .qr-submit-btn {
            width: 100%;
            padding: 0.875rem 1rem;
            border: none;
            border-radius: 0.625rem;
            background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%);
            color: #fff;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
        }
        .qr-submit-btn:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #6d28d9 100%);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
            transform: translateY(-1px);
        }
        .qr-submit-btn:active {
            transform: translateY(0);
        }
        .qr-submit-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        .qr-status {
            margin-top: 1rem;
            padding: 0.75rem 1rem;
            border-radius: 0.625rem;
            font-size: 0.875rem;
            text-align: center;
        }
        .qr-status.info {
            background: #eff6ff;
            color: #1e40af;
            border: 1px solid #bfdbfe;
        }
        body.login-page.dark .qr-status.info {
            background: rgba(30, 64, 175, 0.1);
            color: #93c5fd;
            border-color: rgba(30, 64, 175, 0.3);
        }
        .qr-status.success {
            background: #f0fdf4;
            color: #166534;
            border: 1px solid #bbf7d0;
        }
        body.login-page.dark .qr-status.success {
            background: rgba(22, 101, 52, 0.1);
            color: #86efac;
            border-color: rgba(22, 101, 52, 0.3);
        }
        .qr-status.error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }
        body.login-page.dark .qr-status.error {
            background: rgba(153, 27, 27, 0.1);
            color: #fca5a5;
            border-color: rgba(153, 27, 27, 0.3);
        }

        /* Azure AD Button */
        .azure-ad-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 0.625rem;
            background: #fff;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            color: #374151;
            margin-bottom: 1rem;
        }
        .azure-ad-btn:hover {
            border-color: #6366f1;
            background: rgba(99, 102, 241, 0.05);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
            transform: translateY(-1px);
        }
        .dark .azure-ad-btn {
            background: #1e293b;
            border-color: #475569;
            color: #e2e8f0;
        }
        .dark .azure-ad-btn:hover {
            background: #334155;
            border-color: #6366f1;
            color: #c7d2fe;
        }
        .azure-ad-btn .ms-logo {
            width: 20px;
            height: 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5px;
            flex-shrink: 0;
        }
        .azure-ad-btn .ms-logo span {
            display: block;
            border-radius: 1px;
        }

        /* Divider */
        .login-divider {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 1.25rem 0;
        }
        .login-divider::before, .login-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e5e7eb;
        }
        .login-divider span {
            font-size: 0.75rem;
            font-weight: 500;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        .dark .login-divider::before, .dark .login-divider::after { background: #475569; }
        .dark .login-divider span { color: #64748b; }

        .auth-divider-text {
            text-align: center;
            font-size: 0.7rem;
            font-weight: 500;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 1.25rem;
        }
        .dark .auth-divider-text { color: #64748b; }

        /* Form Fields */
        .form-group { margin-bottom: 1.125rem; }
        .form-group .form-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.375rem;
        }
        .form-group .form-label .required { color: #ef4444; margin-left: 2px; }
        .form-group .input-wrapper { position: relative; }
        .form-group .input-wrapper .input-icon {
            position: absolute;
            left: 0.875rem;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            pointer-events: none;
            display: flex;
            align-items: center;
        }
        .form-group .form-input {
            width: 100%;
            padding: 0.7rem 0.875rem 0.7rem 2.75rem;
            border: 1.5px solid #e5e7eb;
            border-radius: 0.625rem;
            font-size: 0.9rem;
            color: #1e1e2f;
            background: #fff;
            transition: all 0.2s ease;
            outline: none;
        }
        .form-group .form-input::placeholder { color: #c0c4cc; }
        .form-group .form-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }
        .dark .form-group .form-label { color: #cbd5e1; }
        .dark .form-group .form-input {
            background: #1e293b;
            border-color: #475569;
            color: #e2e8f0;
        }
        .dark .form-group .form-input::placeholder { color: #64748b; }
        .dark .form-group .form-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }
        .dark .form-group .input-icon { color: #64748b; }

        /* Submit Button */
        .login-submit-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 0.8rem 1rem;
            border: none;
            border-radius: 0.625rem;
            background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%);
            color: #fff;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
            margin-top: 0.5rem;
        }
        .login-submit-btn:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #6d28d9 100%);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
            transform: translateY(-1px);
        }
        .login-submit-btn:active { transform: translateY(0); }

        /* Error Alert */
        .login-error-alert {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 0.625rem;
            margin-bottom: 1rem;
        }
        .login-error-alert svg { flex-shrink: 0; color: #ef4444; }
        .login-error-alert span { font-size: 0.8rem; color: #991b1b; }
        .dark .login-error-alert {
            background: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.3);
        }
        .dark .login-error-alert span { color: #fca5a5; }

        /* Validation errors */
        .field-validation-error {
            font-size: 0.75rem;
            color: #ef4444;
            margin-top: 0.25rem;
            display: block;
        }
    </style>
</head>
<body
    x-data="{ darkMode: (function() { const t = localStorage.getItem('theme'); if (t === 'dark') return true; if (t === 'light') return false; const d = localStorage.getItem('darkMode'); if (d === 'true') return true; if (d === 'false') return false; return window.matchMedia('(prefers-color-scheme: dark)').matches; })() }"
    x-init="$watch('darkMode', value => { localStorage.setItem('darkMode', JSON.stringify(value)); localStorage.setItem('theme', value ? 'dark' : 'light'); })"
    :class="{ 'dark': darkMode }"
    class="login-page">

    <!-- Login Card -->
    <div class="login-card">
        <div class="card-logo">
            <img :src="darkMode ? '@Url.Content("~/img/logo/logo-dark.png")' : '@Url.Content("~/img/logo/logo.png")'" alt="MVC Boilerplate" />
        </div>
        <h1 class="card-title">Sign In</h1>
        <p class="card-desc">Access the MVC Boilerplate with your credentials</p>

        @* Display error messages *@
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="login-error-alert">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }


        @* Azure AD Login Link *@
        @if (!string.IsNullOrEmpty(ViewBag.AzureRedirectUrl))
        {
            <a href="@ViewBag.AzureRedirectUrl" class="azure-ad-btn azure-ad-link">
                <div class="ms-logo">
                    <span style="background:#f25022;"></span>
                    <span style="background:#7fba00;"></span>
                    <span style="background:#00a4ef;"></span>
                    <span style="background:#ffb900;"></span>
                </div>
                <span>Sign in with Azure</span>
            </a>
        }

        <div class="auth-divider-text azure-ad-divider">OR USE YOUR STAFF ID</div>

        <!-- Login Form -->
        <form id="account" method="post" asp-controller="Account" asp-action="Login">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-sm mb-3" role="alert" style="color:#ef4444;"></div>

            <!-- Staff ID -->
            <div class="form-group">
                <span class="form-label">Staff ID <span class="required">*</span></span>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                    </span>
                    <input asp-for="Email" type="text" autocomplete="off" aria-required="true" placeholder="e.g. M00001" class="form-input" />
                </div>
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <!-- Password -->
            <div class="form-group">
                <span class="form-label">Password <span class="required">*</span></span>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                    </span>
                    <input asp-for="Password" type="password" autocomplete="current-password" aria-required="true" placeholder="Enter your password" class="form-input" />
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="login-remember-row">
                <label class="login-remember-label">
                    <!-- <input asp-for="RememberMe" type="checkbox" />
                    <span>Remember me</span> -->
                </label>
                <button type="button" id="forgot-password" class="login-forgot-link" onclick="openForgotPasswordModal()">Forgot password?</button>
            </div>

            <!-- Sign In Button -->
            <button id="login-submit" type="submit" class="login-submit-btn">
                Sign In
            </button>
        </form>

    </div>

    <!-- Footer -->
    <div class="login-footer">
        <p>&copy; @DateTime.Now.Year ISUZU HICOM MALAYSIA SDN BHD</p>
        <div class="login-footer-links">
            <a href="#" onclick="openPrivacyModal(event)">Privacy Policy</a>
            <span class="login-footer-dot">&bull;</span>
            <a href="https://mhs.isuzu-hicom.com.my" target="_blank" rel="noopener noreferrer">Help Center</a>
        </div>
    </div>

    <!-- Dark Mode Toggler -->
    <button class="dark-mode-toggler" @@click.prevent="darkMode = !darkMode" title="Toggle dark mode">
        <svg x-show="darkMode" width="20" height="20" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10 1.54c.414 0 .75.336.75.75v1.25a.75.75 0 01-1.5 0V2.29a.75.75 0 01.75-.75zM10 6.79a3.21 3.21 0 100 6.42 3.21 3.21 0 000-6.42zM5.29 10a4.71 4.71 0 119.42 0 4.71 4.71 0 01-9.42 0zm10.69-4.92a.75.75 0 00-1.06-1.06l-.884.884a.75.75 0 001.06 1.06l.884-.884zM18.46 10a.75.75 0 01-.75.75h-1.25a.75.75 0 010-1.5h1.25a.75.75 0 01.75.75zm-3.54 5.98a.75.75 0 001.06-1.06l-.884-.884a.75.75 0 00-1.06 1.06l.884.884zM10 15.71a.75.75 0 01.75.75v1.25a.75.75 0 01-1.5 0v-1.25a.75.75 0 01.75-.75zm-4.04-.61a.75.75 0 00-1.06-1.06l-.884.884a.75.75 0 001.06 1.06l.884-.884zM4.29 10a.75.75 0 01-.75.75H2.29a.75.75 0 010-1.5h1.25a.75.75 0 01.75.75zm.61-4.04a.75.75 0 001.06-1.06L5.08 4.02a.75.75 0 00-1.06 1.06l.884.884z"/>
        </svg>
        <svg x-show="!darkMode" width="20" height="20" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.455 11.97a6.92 6.92 0 01-4.54 1.033 6.5 6.5 0 01-5.83-5.918 6.92 6.92 0 01.946-4.54A8.46 8.46 0 001.542 10c0 4.672 3.787 8.459 8.458 8.459a8.46 8.46 0 007.455-6.489z"/>
        </svg>
    </button>

    <!-- Privacy Policy Modal -->
    <div id="privacy-policy-modal" class="forgot-modal-overlay" onclick="closePrivacyModal(event)">
        <div class="forgot-modal-card" style="max-width:520px;" onclick="event.stopPropagation()">
            <button type="button" class="forgot-modal-close" onclick="closePrivacyModal(event)" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <div style="display:flex; justify-content:center; margin-bottom:1rem; padding-top:0.25rem;">
                <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="28" cy="28" r="26" stroke="#06b6d4" stroke-width="2"/>
                    <line x1="28" y1="24" x2="28" y2="38" stroke="#06b6d4" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="28" cy="18" r="2" fill="#06b6d4"/>
                </svg>
            </div>
            <h2 class="forgot-modal-title" style="text-align:center; padding-right:0;">Privacy Policy</h2>
            <div class="privacy-modal-scroll">
                <div class="privacy-modal-body">
                    <p>This system is intended for authorized <strong>ISUZU HICOM MALAYSIA SDN BHD</strong> personnel only.</p>
                    <p>Personal and business information collected or processed through this system will be used only for authorized company operations, administration, security, compliance, and audit purposes.</p>
                    <p>Users are responsible for maintaining the confidentiality of their login credentials and must not disclose, misuse, copy, or distribute confidential company information without proper authorization.</p>
                    <p>By accessing and using this system, you agree to comply with the Company's applicable information security, data protection, privacy, and acceptable-use policies.</p>
                    <p>For privacy or information-security concerns, please contact the <strong>Management Integrated Systems (MIS) Department</strong>.</p>
                </div>
            </div>
            <div class="forgot-modal-actions" style="margin-top:1.25rem; justify-content:center;">
                <button type="button" class="forgot-modal-btn" onclick="closePrivacyModal(event)">Close</button>
            </div>
        </div>
    </div>

    <!-- Forgot Password Modal -->
    <div id="forgot-password-modal" class="forgot-modal-overlay" onclick="closeForgotPasswordModal(event)">
        <div class="forgot-modal-card" onclick="event.stopPropagation()">
            <button type="button" class="forgot-modal-close" onclick="closeForgotPasswordModal(event)" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <h2 class="forgot-modal-title">Password Reset</h2>
            <p class="forgot-modal-desc">
                Please contact the MIS Helpdesk or your system administrator to reset your Active Directory password.
            </p>
            <div class="forgot-modal-actions">
                <button type="button" class="forgot-modal-btn" onclick="closeForgotPasswordModal(event)">Understood</button>
            </div>
        </div>
    </div>


    <script>
        function openForgotPasswordModal() {
            const modal = document.getElementById('forgot-password-modal');
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeForgotPasswordModal(event) {
            if (event) event.preventDefault();
            const modal = document.getElementById('forgot-password-modal');
            modal.classList.remove('show');
            document.body.style.overflow = '';
        }

        function openPrivacyModal(event) {
            if (event) event.preventDefault();
            const modal = document.getElementById('privacy-policy-modal');
            modal.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closePrivacyModal(event) {
            if (event) event.preventDefault();
            const modal = document.getElementById('privacy-policy-modal');
            modal.classList.remove('show');
            document.body.style.overflow = '';
        }

        // Close on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeForgotPasswordModal();
                closePrivacyModal();
            }
        });
    </script>
    <script src="~/js/bundle.js" asp-append-version="true"></script>

    <!-- Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />
</body>
</html>