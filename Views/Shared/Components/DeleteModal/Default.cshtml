@model mvc_boilerplate.Models.DeleteModalViewModel

<!-- Delete Confirmation Modal -->
<div id="@Model.ModalId" class="fixed inset-0 bg-gray-500 bg-opacity-50 backdrop-blur-sm hidden z-[999999] flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-md">
        <div class="p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">@Model.Title</h3>
                <button onclick="closeDeleteModal('@Model.ModalId')" class="w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            
            <p class="text-gray-600 dark:text-gray-400 mb-6">
                @Html.Raw(Model.Message)
            </p>
            
            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeDeleteModal('@Model.ModalId')" class="px-6 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg transition-colors">
                    @Model.CancelButtonText
                </button>
                <form id="@Model.FormId" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="px-6 py-2 text-sm font-medium text-white bg-error hover:bg-error/90 rounded-lg transition-colors">
                        @Model.DeleteButtonText
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>

(function () {
    var modal = document.getElementById('@Model.ModalId');
    if (modal) document.body.appendChild(modal);
})();

function openDeleteModal_@(Model.ModalId)(itemId, itemName) {
    const itemDisplay = itemName ? itemName + ' (' + itemId + ')' : itemId;
    const formElement = document.getElementById('@Model.FormId');
    
    // Set the form action using query parameter
    const baseAction = '@Html.Raw(Model.DeleteAction)';
    formElement.action = baseAction + '?id=' + encodeURIComponent(itemId);
    
    // Update the modal display if needed
    const itemNameElement = document.getElementById('@Model.ItemNameElementId');
    if (itemNameElement) {
        itemNameElement.textContent = itemDisplay;
    }
    
    document.getElementById('@Model.ModalId').classList.remove('hidden');
}

function closeDeleteModal(modalId) {
    const modal = document.getElementById(modalId || '@Model.ModalId');
    if (modal) {
        modal.classList.add('hidden');
    }
}

// Close modal when clicking outside
document.getElementById('@Model.ModalId')?.addEventListener('click', function(e) {
    if (e.target === this) {
        closeDeleteModal('@Model.ModalId');
    }
});
</script>
