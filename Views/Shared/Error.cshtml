@model mvc_boilerplate.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = Model.GetErrorType();
    Layout = null;

    var codeStr = (Model.StatusCode ?? 500).ToString();
    var firstDigit = codeStr.Length > 0 ? codeStr[0] : '5';
    var lastDigit = codeStr.Length > 2 ? codeStr[codeStr.Length - 1] : '0';
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <style>
        :root {
            --blue: #3c50e0;
            --pink: #f04438;
            --pink-light: #fee4e2;
            --white: white;
            --gray: #64748b;
            --gray-light: #f8f9fa;
            --border: #e5e7eb;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html { font-size: 62.5%; height: 100%; }

        body {
            font-family: 'Lato', sans-serif;
            font-size: 1.5rem;
            color: var(--blue);
            background: var(--gray-light);
            height: 100%;
        }

        a { text-decoration: none; }

        .center {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 20px;
            overflow-y: auto;
        }

        .error {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-content: center;
            margin-bottom: 3rem;
        }

        .number {
            font-weight: 900;
            font-size: 15rem;
            line-height: 1;
            color: var(--blue);
        }

        .illustration {
            position: relative;
            width: 12.2rem;
            margin: 0 2.1rem;
        }

        .circle {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 12.2rem;
            height: 11.4rem;
            border-radius: 50%;
            background-color: var(--blue);
        }

        .clip {
            position: absolute;
            bottom: 0.3rem;
            left: 50%;
            transform: translateX(-50%);
            overflow: hidden;
            width: 12.5rem;
            height: 13rem;
            border-radius: 0 0 50% 50%;
        }

        .paper {
            position: absolute;
            bottom: -0.3rem;
            left: 50%;
            transform: translateX(-50%);
            width: 9.2rem;
            height: 12.4rem;
            border: 0.3rem solid var(--blue);
            background-color: var(--white);
            border-radius: 0.8rem;
        }

        .paper::before {
            content: "";
            position: absolute;
            top: -0.7rem;
            right: -0.7rem;
            width: 1.4rem;
            height: 1rem;
            background-color: var(--white);
            border-bottom: 0.3rem solid var(--blue);
            transform: rotate(45deg);
        }

        .face { position: relative; margin-top: 2.3rem; }

        .eyes {
            position: absolute;
            top: 0;
            left: 2.4rem;
            width: 4.6rem;
            height: 0.8rem;
        }

        .eye {
            position: absolute;
            bottom: 0;
            width: 0.8rem;
            height: 0.8rem;
            border-radius: 50%;
            background-color: var(--blue);
            animation: eye 4s ease-in-out infinite;
        }

        .eye-left { left: 0; }
        .eye-right { right: 0; }

        @@keyframes eye {
            0%, 50%, 54%, 100% { height: 0.8rem; }
            52% { height: 0.1rem; }
        }

        .rosyCheeks {
            position: absolute;
            top: 1.6rem;
            width: 1rem;
            height: 0.2rem;
            border-radius: 50%;
            background-color: var(--pink);
        }

        .rosyCheeks-left { left: 1.4rem; }
        .rosyCheeks-right { right: 1.4rem; }

        .mouth {
            position: absolute;
            top: 3.1rem;
            left: 50%;
            width: 1.6rem;
            height: 0.2rem;
            border-radius: 0.1rem;
            transform: translateX(-50%);
            background-color: var(--blue);
        }

        .text {
            margin-top: 2rem;
            font-weight: 300;
            color: var(--gray);
            font-size: 1.6rem;
            max-width: 600px;
            line-height: 1.7;
            text-align: center;
        }

        .error-details-container {
            background: white;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            margin: 3rem auto;
            text-align: left;
            max-width: 600px;
            width: 100%;
        }

        .error-details-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .error-details-list {
            list-style: none;
            font-size: 1.4rem;
            color: var(--gray);
            line-height: 1.8;
        }

        .error-details-list li {
            padding-left: 20px;
            position: relative;
            margin-bottom: 8px;
        }

        .error-details-list li:before {
            content: "•";
            position: absolute;
            left: 8px;
            color: #94a3b8;
        }

        .btn-group {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .button {
            padding: 1.2rem 2.8rem;
            border-radius: 6px;
            font-size: 1.5rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
            border: none;
        }

        .button-primary { background: var(--blue); color: var(--white); }
        .button-primary:hover { background: #273bd4ff; }

        .button-secondary {
            background: white;
            color: #475569;
            border: 1px solid var(--border);
        }

        .button-secondary:hover { background: var(--gray-light); border-color: #cbd5e1; }

        @@media (max-width: 768px) {
            .number { font-size: 10rem; }
            .illustration { width: 8rem; margin: 0 1rem; }
            .circle { width: 8rem; height: 7.5rem; }
            .clip { width: 8.2rem; height: 8.5rem; }
            .paper { width: 6rem; height: 8.2rem; }
            .face { margin-top: 1.5rem; }
            .eyes { top: 0; left: 1.5rem; width: 3rem; height: 0.5rem; }
            .eye { width: 0.5rem; height: 0.5rem; animation-name: eye-mobile; }
            .rosyCheeks { top: 1rem; width: 0.65rem; height: 0.13rem; }
            .rosyCheeks-left { left: 1rem; }
            .rosyCheeks-right { right: 1rem; }
            .mouth { top: 2rem; width: 1rem; height: 0.13rem; }
        }

        @@keyframes eye-mobile {
            0%, 50%, 54%, 100% { height: 0.5rem; }
            52% { height: 0.1rem; }
        }
    </style>
</head>
<body>
    <div class="center">
        <div class="error">
            <div class="number">@firstDigit</div>
            <div class="illustration">
                <div class="circle"></div>
                <div class="clip">
                    <div class="paper">
                        <div class="face">
                            <div class="eyes">
                                <div class="eye eye-left"></div>
                                <div class="eye eye-right"></div>
                            </div>
                            <div class="rosyCheeks rosyCheeks-left"></div>
                            <div class="rosyCheeks rosyCheeks-right"></div>
                            <div class="mouth"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="number">@lastDigit</div>
        </div>

        <div style="font-size: 2.8rem; font-weight: 600; color: var(--blue); margin-bottom: 1.5rem; text-align: center;">@Model.GetErrorType()</div>
        <div class="text">@Model.GetErrorDescription()</div>

        <div class="error-details-container">
            <div class="error-details-title">@Model.GetErrorDetailsTitle()</div>
            <ul class="error-details-list">
                @if (Model.StatusCode == 404)
                {
                    <li>The URL may have been mistyped</li>
                    <li>The page may have been moved or deleted</li>
                    <li>Your bookmark may be outdated</li>
                }
                else if (Model.StatusCode == 401 || Model.StatusCode == 403)
                {
                    <li>Verify your authentication credentials</li>
                    <li>Contact system administrator for access</li>
                    <li>Check if you need additional permissions</li>
                }
                else if (Model.StatusCode == 500)
                {
                    <li>Refresh the page and try again</li>
                    <li>Clear your browser cache</li>
                    <li>Contact support if the problem persists</li>
                }
                else if (Model.StatusCode == 503)
                {
                    <li>Service is undergoing maintenance</li>
                    <li>Normal operations will resume shortly</li>
                    <li>Please check back in a few minutes</li>
                }
                else
                {
                    <li>Something went wrong</li>
                    <li>Please try again later</li>
                    <li>Contact support if the problem persists</li>
                }
            </ul>
        </div>

        <div class="btn-group">
            <a asp-controller="Home" asp-action="Index" class="button button-primary">Return to Dashboard</a>
            <a href="javascript:history.back()" class="button button-secondary">Go Back</a>
        </div>
    </div>
</body>
</html>
